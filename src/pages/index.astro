---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar/Navbar';
import Hero from '../components/Hero/Hero';
import TrustBar from '../components/TrustBar/TrustBar';
---

<Layout title="Ready4BPO | Bilingual Careers in Tech">
	<Navbar client:load />
	<main>
		<Hero client:load />
		<TrustBar client:visible />

		<footer style={{ padding: '4rem 1.5rem', borderTop: '1px solid rgba(255,255,255,0.1)', background: 'var(--color-bg-base)' }}>
			<div className="container-max" style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'space-between', gap: '2rem' }}>
				<div style={{ fontSize: '1.5rem', fontWeight: 800, fontFamily: 'var(--font-heading)', color: 'var(--color-text-primary)' }}>Ready4BPO</div>
				<div style={{ color: 'var(--color-text-muted)', fontSize: '0.875rem' }}>
					© 2026 Ready4BPO. All rights reserved.
				</div>
				<div style={{ display: 'flex', gap: '1.5rem' }}>
					<a href="#" style={{ color: 'var(--color-text-muted)', textDecoration: 'none', transition: 'color 0.2s' }}>Twitter</a>
					<a href="#" style={{ color: 'var(--color-text-muted)', textDecoration: 'none', transition: 'color 0.2s' }}>Instagram</a>
					<a href="#" style={{ color: 'var(--color-text-muted)', textDecoration: 'none', transition: 'color 0.2s' }}>LinkedIn</a>
				</div>
			</div>
		</footer>
	</main>
</Layout>
